<mapper namespace="com.graduation.platform.repository.BillingRepository">
    <resultMap id="BillingRecordResultMap" type="com.graduation.platform.model.entity.BillingRecord">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="order_id" property="orderId" />
        <result column="start_time" property="startTime" />
        <result column="end_time" property="endTime" />
        <result column="amount" property="amount" />
        <result column="created_at" property="createdAt" />
    </resultMap>

    <select id="selectBillingRecords" resultMap="BillingRecordResultMap">
        SELECT * FROM billing_record
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <insert id="insertBillingRecord" parameterType="com.graduation.platform.model.entity.BillingRecord">
        INSERT INTO billing_record (user_id, order_id, start_time, end_time, amount, created_at)
        VALUES (#{userId}, #{orderId}, #{startTime}, #{endTime}, #{amount}, #{createdAt})
    </insert>

    <update id="updateBillingRecord" parameterType="com.graduation.platform.model.entity.BillingRecord">
        UPDATE billing_record
        SET end_time = #{endTime}, amount = #{amount}
        WHERE id = #{id}
    </update>

    <delete id="deleteBillingRecord" parameterType="Long">
        DELETE FROM billing_record WHERE id = #{id}
    </delete>
</mapper>